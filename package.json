{
  "name": "bdnix",
  "private": true,
  "license": "MIT",
  "description": "Build and test tooling for www.bdnix.com. The site is static files; `npm run build` updates their cache-busting hashes.",
  "scripts": {
    "serve": "node tests/server.mjs",
    "build": "node scripts/build.mjs",
    "build:check": "node scripts/build.mjs --check",
    "test": "npm run test:unit && npm run test:ui",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:ui": "playwright test",
    "coverage": "npm run coverage:unit && npm run coverage:ui && npm run coverage:report",
    "coverage:unit": "mcr -c tests/coverage/unit.config.mjs node --test \"tests/unit/*.test.mjs\"",
    "coverage:ui": "COVERAGE=1 playwright test",
    "coverage:ui:cached": "node scripts/ui-cache.mjs",
    "coverage:report": "mcr merge -c tests/coverage/report.config.mjs",
    "og-image": "node scripts/og-image.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "monocart-coverage-reports": "2.13.0"
  },
  "engines": {
    "node": ">=22"
  }
}
